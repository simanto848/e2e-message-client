# Point the app at a locally-running server instead of the deployed default.
# Find your machine's LAN IP (not localhost/127.0.0.1 — a physical device or
# emulator needs to reach it over the network) and match the server's PORT.
EXPO_PUBLIC_BACKEND_URL=http://192.168.1.100:5050

# TURN relay for voice/video calls (REQUIRED for audio between NAT'd networks,
# e.g. Android emulator <-> phone on mobile data — direct P2P almost never
# connects there). Get free credentials (Metered free plan ~5GB/mo, or
# self-hosted coturn) and list them comma-separated. The bundled OpenRelay
# community credentials are a last-resort fallback and are frequently
# throttled — if calls connect but stay silent, set these first.
# EXPO_PUBLIC_TURN_URLS=turn:global.relay.metered.ca:80,turn:global.relay.metered.ca:80?transport=tcp,turn:global.relay.metered.ca:443,turns:global.relay.metered.ca:443?transport=tcp
# EXPO_PUBLIC_TURN_USERNAME=your_username
# EXPO_PUBLIC_TURN_CREDENTIAL=your_credential
